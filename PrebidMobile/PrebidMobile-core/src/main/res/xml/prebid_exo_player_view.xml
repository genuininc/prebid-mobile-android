<?xml version="1.0" encoding="utf-8"?>
<!--
  The attributes ExoPlayerView is built with. A TextureView rather than PlayerView's default
  SurfaceView: an app may move the ad's view between windows (a feed slot and a full-screen page),
  and a SurfaceView keeps the geometry of the window it was first shown in — the video then plays
  scaled and cropped in the other one. A TextureView is drawn in the view hierarchy and follows it.
-->
<androidx.media3.ui.PlayerView xmlns:app="http://schemas.android.com/apk/res-auto"
    app:surface_type="texture_view" />
